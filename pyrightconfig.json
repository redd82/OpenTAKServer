{
    "venvPath": "/home/takusr",
    "venv": ".opentakserver_venv",
    "pythonPath": "/home/takusr/.opentakserver_venv/bin/python",
    "include": [
        "opentakserver",
        "tests"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.pytest_cache",
        "**/.mypy_cache",
        "**/*.egg-info",
        ".git",
        ".venv",
        "venv",
        "env",
        "build",
        "dist",
        ".tox",
        "/sys/**",
        "/usr/**",
        "/var/**",
        "/proc/**",
        "/dev/**",
        "/tmp/**",
        "/run/**",
        "/boot/**",
        "/lib/**",
        "/lib64/**",
        "/opt/**",
        "/mnt/**",
        "/media/**"
    ],
    "autoSearchPaths": false,
    "extraPaths": [],
    "pythonVersion": "3.12",
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true,
    "stubPath": "./typings"
}